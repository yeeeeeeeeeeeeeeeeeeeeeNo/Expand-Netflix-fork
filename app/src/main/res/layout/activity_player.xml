<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ns1="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        ns1:use_controller="false"
        ns1:surface_type="surface_view"
        ns1:resize_mode="fit" />

    <View
        android:id="@+id/vignetteTop"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:layout_gravity="top"
        android:rotation="180"
        android:background="@drawable/bg_hero_scrim_bottom" />

    <View
        android:id="@+id/vignetteBottom"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hero_scrim_bottom" />

    <RelativeLayout
        android:id="@+id/hudTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="22dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOCTURNE"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:maxWidth="580dp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/tvPlayerStreamBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#CC000000"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Initializing Stream"
                android:textColor="#DCDCE2"
                android:textSize="10.5sp"
                android:fontFamily="monospace" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/ic_nocturne_spider"
                android:alpha="0.82"
                android:contentDescription="NOCTURNE" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOCTURNE"
                android:textColor="#99FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.18" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/tvSeekOsd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/selector_pill_secondary"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Netflix Monochrome SKIP INTRO Button -->
    <TextView
        android:id="@+id/btnSkipIntro"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="116dp"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/selector_pill_secondary"
        android:text="SKIP INTRO  ▸"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:focusable="true"
        android:clickable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/hudControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/scrubberRow"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:id="@+id/tvTimeCurrent"
                android:layout_width="wrap_content"
                android:minWidth="54dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="end" />
            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:max="1000"
                android:progress="0"
                android:focusable="true"
                android:nextFocusDown="@+id/btnPlayPause"
                android:progressDrawable="@drawable/scrubber_progress_track"
                android:thumb="@drawable/scrubber_thumb"
                android:splitTrack="false" />
            <TextView
                android:id="@+id/tvTimeDuration"
                android:layout_width="wrap_content"
                android:minWidth="54dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#A4A8B2"
                android:textSize="11.5sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="start" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/buttonsRow"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <LinearLayout
                android:id="@+id/leftButtonsGroup"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageButton android:id="@+id/btnPrev" android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_player_prev" android:background="@drawable/bg_player_btn_mini" android:focusable="true" android:clickable="true" android:padding="7dp" android:nextFocusUp="@+id/seekBar" android:nextFocusRight="@+id/btnPlayPause" android:contentDescription="Previous Episode" />
                <ImageButton android:id="@+id/btnPlayPause" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="10dp" android:src="@drawable/ic_player_play" android:background="@drawable/bg_player_btn_mini" android:focusable="true" android:clickable="true" android:padding="7dp" android:nextFocusUp="@+id/seekBar" android:nextFocusLeft="@+id/btnPrev" android:nextFocusRight="@+id/btnNext" android:contentDescription="Play / Pause" />
                <ImageButton android:id="@+id/btnNext" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="10dp" android:src="@drawable/ic_player_next" android:background="@drawable/bg_player_btn_mini" android:focusable="true" android:clickable="true" android:padding="7dp" android:nextFocusUp="@+id/seekBar" android:nextFocusLeft="@+id/btnPlayPause" android:nextFocusRight="@+id/btnSources" android:contentDescription="Next Episode" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rightButtonsGroup"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageButton android:id="@+id/btnSources" android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_player_sources" android:background="@drawable/bg_player_btn_mini" android:focusable="true" android:clickable="true" android:padding="7dp" android:nextFocusUp="@+id/seekBar" android:nextFocusLeft="@+id/btnNext" android:nextFocusRight="@+id/btnSubtitles" android:contentDescription="Switch Source" />
                <ImageButton android:id="@+id/btnSubtitles" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="10dp" android:src="@drawable/ic_player_subs" android:background="@drawable/bg_player_btn_mini" android:focusable="true" android:clickable="true" android:padding="7dp" android:nextFocusUp="@+id/seekBar" android:nextFocusLeft="@+id/btnSources" android:nextFocusRight="@+id/btnAudio" android:contentDescription="Subtitles &amp; Sync" />
                <ImageButton android:id="@+id/btnAudio" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="10dp" android:src="@drawable/ic_player_audio" android:background="@drawable/bg_player_btn_mini" android:focusable="true" android:clickable="true" android:padding="7dp" android:nextFocusUp="@+id/seekBar" android:nextFocusLeft="@+id/btnSubtitles" android:nextFocusRight="@+id/btnSettings" android:contentDescription="Audio Language" />
                <ImageButton android:id="@+id/btnSettings" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="10dp" android:src="@drawable/ic_player_settings" android:background="@drawable/bg_player_btn_mini" android:focusable="true" android:clickable="true" android:padding="7dp" android:nextFocusUp="@+id/seekBar" android:nextFocusLeft="@+id/btnAudio" android:contentDescription="Settings" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- Stremio-Style Full-Bleed 4K Artwork & Liquid Glass-Fill Title Loader -->
    <FrameLayout
        android:id="@+id/layoutBuffering"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:elevation="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivLoadingBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Artwork Backdrop" />

        <View
            android:id="@+id/loadingScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_stremio_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="48dp"
            android:paddingEnd="48dp">

            <ImageView
                android:id="@+id/ivLoadingLiveEmblem"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginBottom="16dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="Channel Emblem" />

            <com.d4cx.streamflix.TitleLoadingView
                android:id="@+id/loadingTitle"
                android:layout_width="640dp"
                android:layout_height="154dp" />

            <TextView
                android:id="@+id/tvLoadingEpSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#B0FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/ivLoadingSpider"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_nocturne_spider"
                    android:alpha="0.72"
                    android:contentDescription="NOCTURNE" />
                <TextView
                    android:id="@+id/tvBufferingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connecting..."
                    android:textColor="#88FFFFFF"
                    android:textSize="11.5sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/menuOverlay"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F5070709"
        android:orientation="vertical"
        android:padding="24dp"
        android:elevation="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvMenuTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Options"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="14dp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMenuOptions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
