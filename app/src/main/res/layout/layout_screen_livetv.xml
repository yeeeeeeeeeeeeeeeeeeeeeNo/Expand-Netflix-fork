<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenLiveTvRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="34dp"
    android:paddingEnd="34dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- Compact Museum-Grade Live Broadcast Spotlight Deck -->
    <LinearLayout
        android:id="@+id/liveHeroDeck"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_surface_panel"
        android:paddingStart="16dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginBottom="12dp">

        <!-- Hero Official Channel Logo Stage -->
        <FrameLayout
            android:layout_width="148dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_logo_stage"
            android:padding="16dp">

            <TextView
                android:id="@+id/liveHeroMonogram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="NOCTURNE"
                android:textColor="#94A3B8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />

            <ImageView
                android:id="@+id/liveHeroLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="Selected Channel Logo" />
        </FrameLayout>

        <!-- Hero Info & Action Strip -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/liveHeroBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● LIVE · 1080P FHD"
                    android:textColor="#10B981"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14" />

                <TextView
                    android:id="@+id/liveHeroGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Cartoon &amp; Kids · Nilesat Direct"
                    android:textColor="#8A92A6"
                    android:textSize="10.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/liveHeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cartoon Network Arabic (CN Arabia)"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/btnLiveWatchNow"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:background="@drawable/selector_pill_primary"
                    android:text="▶  Watch Live"
                    android:textColor="#000000"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/btnLivePickFeed"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:background="@drawable/selector_pill_secondary"
                    android:text="Feeds (3)"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/btnLiveBackToGate"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:background="@drawable/selector_pill_secondary"
                    android:text="⇄  Switch Mode"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Clean Unclipped Category Chips + Filter Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLiveCategories"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <EditText
            android:id="@+id/inputLiveFilter"
            android:layout_width="200dp"
            android:layout_height="34dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_search_box"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="Filter channels..."
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />
    </LinearLayout>

    <!-- 4-Column Unclipped Channel Grid -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLiveChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvLiveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Loading Live Channels..."
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
