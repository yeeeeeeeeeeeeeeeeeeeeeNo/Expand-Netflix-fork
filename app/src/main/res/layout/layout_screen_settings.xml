<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="34dp"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOIR Engine &amp; Streaming"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="NOIR v2.0 · Parallel Multi-Addon Racer · Rolling LRU Storage · RGB_565 Low-RAM Pipeline"
            android:textColor="#7A7D87"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_surface_panel"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROLLING CACHE &amp; TV STORAGE GUARD"
                android:textColor="#DDDDDD"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
            <TextView
                android:id="@+id/tvSettingsCacheTelemetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Active Engine Cache: Checking..."
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Maximum Rolling Cache Footprint"
                android:textColor="#9A9EA8"
                android:textSize="11sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView android:id="@+id/btnCache160" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="8dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/selector_chip_pill" android:text="160 MB (Safe)" android:textColor="@color/color_chip_text" android:textSize="11sp" android:textStyle="bold" android:focusable="true" android:clickable="true" />
                <TextView android:id="@+id/btnCache240" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="8dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/selector_chip_pill" android:text="240 MB (Balanced)" android:textColor="@color/color_chip_text" android:textSize="11sp" android:textStyle="bold" android:focusable="true" android:clickable="true" />
                <TextView android:id="@+id/btnCache360" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="8dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/selector_chip_pill" android:text="360 MB (4K)" android:textColor="@color/color_chip_text" android:textSize="11sp" android:textStyle="bold" android:focusable="true" android:clickable="true" />
                <TextView android:id="@+id/btnCacheWipeNow" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/selector_pill_secondary" android:text="Wipe Cache" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:focusable="true" android:clickable="true" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Instant Pre-Warm Top Stream &amp; Next Episode"
                    android:textColor="#D0D2DA"
                    android:textSize="12sp" />
                <TextView android:id="@+id/btnTogglePrewarm" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/selector_chip_pill" android:text="Enabled" android:textColor="@color/color_chip_text" android:textSize="11sp" android:textStyle="bold" android:focusable="true" android:clickable="true" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_surface_panel"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MULTI-ADDON RACER &amp; DEBRID"
                android:textColor="#DDDDDD"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
            <TextView
                android:id="@+id/tvSettingsAddonStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Active Addon: Torrentio + Comet + MediaFusion (Parallel)"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <TextView android:id="@+id/btnSetRealDebrid" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginEnd="10dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/selector_pill_secondary" android:text="Set Real-Debrid Key" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:focusable="true" android:clickable="true" />
                <TextView android:id="@+id/btnSetCustomAddon" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginEnd="10dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/selector_pill_secondary" android:text="Set Custom Addon URL" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:focusable="true" android:clickable="true" />
                <TextView android:id="@+id/btnResetAddon" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/selector_pill_secondary" android:text="Reset Default" android:textColor="#9A9EA8" android:textSize="11sp" android:textStyle="bold" android:focusable="true" android:clickable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
